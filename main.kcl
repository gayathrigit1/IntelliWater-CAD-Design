  |> rotate(axis = X, angle = -90deg, global = true)
  |> translate(
       x = -180mm,
       y = -92mm,
       z = 335mm,
       global = true,
     )
  |> appearance(color = "#555D62")
bathroomSupport = clone(kitchenSupport)
  |> translate(x = 230mm, global = true)
mainSensorSupport = clone(kitchenSupport)
  |> translate(x = 140mm, z = 90mm, global = true)

phoneStand = panelBody(width = 145mm, depth = 100mm, height = 16mm)
  |> translate(x = 440mm, y = 0mm, global = true)
  |> appearance(color = "#865633")
phoneFrame = panelBody(width = 135mm, depth = 12mm, height = 270mm)
  |> translate(
       x = 440mm,
       y = 8mm,
       z = 16mm,
       global = true,
     )
  |> appearance(color = "#18232D")
phoneScreen = panelBody(width = 123mm, depth = 1mm, height = 250mm)
  |> translate(
       x = 440mm,
       y = 1.5mm,
       z = 26mm,
       global = true,
     )
  |> appearance(color = "#153E56")

labels = if showLabels {
  gdt::note(
    note = "INTELLIWATER | REFERENCE PROTOTYPE",
    framePlane = XZ,
    framePosition = [-290mm, 755mm],
    fontSize = 12mm,
  )
  gdt::note(
    note = "600 W x 360 D x 460 H mm CABINET | NOMINAL",
    framePlane = XZ,
    framePosition = [-290mm, -30mm],
    fontSize = 8mm,
  )
  gdt::annotation(
    faces = [water.faces.endCap],
    annotation = "WATER TANK | CUTAWAY",
    framePlane = XZ,
    framePosition = [-210mm, 55mm],
    fontSize = 8mm,
  )
  gdt::annotation(
    faces = [levelSensor.faces.endCap],
    annotation = "LEVEL SENSOR",
    framePlane = XZ,
    framePosition = [110mm, 25mm],
    fontSize = 8mm,
  )
  gdt::annotation(
    faces = [inlet.faces.endCap],
    annotation = "INLET",
    framePlane = XZ,
    framePosition = [-190mm, 5mm],
    fontSize = 8mm,
  )
  gdt::annotation(
    faces = [mainSensor.faces.endCap],
    annotation = "MAIN FLOW SENSOR",
    framePlane = XZ,
    framePosition = [110mm, 0mm],
    fontSize = 8mm,
  )
  gdt::annotation(
    faces = [kitchenHandle.faces.endCap],
    annotation = "KITCHEN TAP",
    framePlane = XZ,
    framePosition = [-160mm, 10mm],
    fontSize = 8mm,
  )
  gdt::annotation(
    faces = [bathroomHandle.faces.endCap],
    annotation = "BATHROOM TAP",
    framePlane = XZ,
    framePosition = [0mm, -55mm],
    fontSize = 8mm,
  )
  gdt::annotation(
    faces = [controllerBoard.faces.endCap],
    annotation = "STM32 CONTROLLER",
    framePlane = XZ,
    framePosition = [100mm, 40mm],
    fontSize = 8mm,
  )
  gdt::annotation(
    faces = [buzzer.faces.endCap],
    annotation = "BUZZER / LED",
    framePlane = XZ,
    framePosition = [100mm, 25mm],
    fontSize = 8mm,
  )
  gdt::note(
    note = "DEMO DASHBOARD",
    framePlane = XZ,
    framePosition = [380mm, 265mm],
    fontSize = 7mm,
  )
  gdt::note(
    note = "Level " + string::toString(floor(waterHeight / 176mm * 100)) + "%",
    framePlane = XZ,
    framePosition = [385mm, 235mm],
    fontSize = 8mm,
  )
  gdt::note(
    note = "Total " + string::toString(demoFlowLitresPerMinute) + " L/min",
    framePlane = XZ,
    framePosition = [385mm, 210mm],
    fontSize = 7mm,
  )
  gdt::note(
    note = "Used " + string::toString(demoUsedLitres) + " L",
    framePlane = XZ,
    framePosition = [385mm, 185mm],
    fontSize = 8mm,
  )
  gdt::note(
    note = "Timer " + string::toString(thresholdMinutes) + " min",
    framePlane = XZ,
    framePosition = [385mm, 160mm],
    fontSize = 8mm,
  )
  gdt::note(
    note =     if tapOn {
      "TAPS: ON"
    } else {
      "TAPS: OFF"
    },
    framePlane = XZ,
    framePosition = [385mm, 130mm],
    fontSize = 8mm,
  )
  gdt::note(
    note =     if buzzerAlert {
      "ALERT"
    } else {
      "STATUS: NORMAL"
    },
    framePlane = XZ,
    framePosition = [385mm, 100mm],
    fontSize = 7mm,
  )
  gdt::note(
    note = "STATIC DEMO DATA",
    framePlane = XZ,
    framePosition = [385mm, 55mm],
    fontSize = 6mm,
  )
} else {
  []
}
